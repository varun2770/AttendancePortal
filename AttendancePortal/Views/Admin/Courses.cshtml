@model List<AttendancePortal.Models.Domain.Course>

@{
    ViewData["Title"] = "Courses";
    var counts = (Dictionary<int, int>)ViewBag.Counts;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Courses</h1>
    <a asp-action="CreateCourse" class="btn btn-primary">Add course</a>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No courses yet. Click "Add course" to create one.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Faculty</th>
                <th>Students</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CourseCode</td>
                    <td>@c.CourseName</td>
                    <td>@(c.Faculty?.FullName ?? "Unassigned")</td>
                    <td>@(counts.TryGetValue(c.Id, out var n) ? n : 0)</td>
                    <td class="text-end">
                        <a asp-action="EditCourse" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="DeleteCourse" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete @c.CourseCode?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-link">Back to dashboard</a>