@model List<AttendancePortal.Models.Domain.Faculty>

@{
    ViewData["Title"] = "Faculty";
    var emails = (Dictionary<int, string>)ViewBag.Emails;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Faculty</h1>
    <a asp-action="CreateFaculty" class="btn btn-primary">Add faculty</a>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No faculty yet. Click "Add faculty" to create one.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Courses</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>@f.FullName</td>
                    <td>@(emails.TryGetValue(f.Id, out var email) ? email : "")</td>
                    <td>@f.Department</td>
                    <td>@f.Courses.Count</td>
                    <td class="text-end">
                        <a asp-action="EditFaculty" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="DeleteFaculty" asp-route-id="@f.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete @f.FullName?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-link">Back to dashboard</a>